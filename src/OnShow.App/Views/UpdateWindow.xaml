<Window Icon="pack://application:,,,/Assets/onshow.ico" x:Class="OnShow.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnShow 更新" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MaxHeight="640"
        ShowInTaskbar="False" Topmost="True" Closing="OnClosing"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border CornerRadius="12" Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" Margin="10"
            MouseLeftButtonDown="OnDragAreaMouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="9"
                        Background="{DynamicResource BrushAccentDim}" VerticalAlignment="Center">
                    <TextBlock Text="⬆" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="发现新版本" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource BrushFg1}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="VersionLine" FontSize="12" Foreground="{DynamicResource BrushFg2}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,14,0,10" Background="{DynamicResource BrushCard}"
                    CornerRadius="10" Padding="14,8" Height="220">
                <FlowDocumentScrollViewer x:Name="NotesViewer" VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"/>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100"
                             Background="#1FFFFFFF" BorderThickness="0"
                             Foreground="{DynamicResource BrushAccent}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="2.5" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource BrushFg2}"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseBtn" Content="稍后" Click="OnLater" Margin="0,0,9,0"/>
                <Button x:Name="SkipBtn" Content="跳过此版本" Click="OnSkip" Margin="0,0,9,0"/>
                <Button x:Name="UpdateBtn" Content="立即更新" Style="{StaticResource BtnPrimary}"
                        IsDefault="True" Click="OnUpdateNow" MinWidth="96"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
