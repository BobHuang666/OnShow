<Window Icon="pack://application:,,,/Assets/onshow.ico" x:Class="OnShow.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OnShow.App"
        Title="OnShow" Width="360" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border x:Name="RootBorder" Margin="6" CornerRadius="14"
            Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
            MouseLeftButtonDown="OnBackgroundMouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 头部 ===== -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccent}" Margin="0,0,6,0"/>
                    <TextBlock Text="OnShow" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource BrushFg1}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="＋" Style="{StaticResource IconBtn}" Tag="btn" ToolTip="添加 DDL"
                               MouseLeftButtonUp="OnAddDdlClick"/>
                    <TextBlock Text="⟳" Style="{StaticResource IconBtn}" Tag="btn" ToolTip="刷新 Token"
                               MouseLeftButtonUp="OnRefreshClick"/>
                    <TextBlock Text="⚙" Style="{StaticResource IconBtn}" Tag="btn" ToolTip="设置"
                               MouseLeftButtonUp="OnSettingsClick"/>
                    <TextBlock Text="—" Style="{StaticResource IconBtn}" Tag="btn" ToolTip="隐藏到托盘"
                               MouseLeftButtonUp="OnHideClick"/>
                </StackPanel>
            </Grid>

            <!-- ===== DDL 区 ===== -->
            <TextBlock x:Name="DdlSectionTitle" Grid.Row="1" Style="{StaticResource SectionTitle}"
                       Margin="2,10,0,8" Text="⏰ DDL 倒计时"/>

            <ScrollViewer Grid.Row="2" MaxHeight="230" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="DdlEmpty" Text="暂无 DDL,点右上角 ＋ 添加"
                               FontSize="11" Foreground="{DynamicResource BrushFg2}" Margin="2,0,0,8"/>
                    <ItemsControl x:Name="DdlList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}" Tag="{Binding Id}"
                                        ToolTip="{Binding Note}"
                                        MouseLeftButtonDown="OnDdlRowClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushFg1}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DueText}" FontSize="10"
                                                       Foreground="{DynamicResource BrushFg2}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RemainText}"
                                                   FontSize="15" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushFar}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="near">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushNear}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="urgent">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushUrgent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="over">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushOver}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="done">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushOver}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Token 区 ===== -->
            <TextBlock x:Name="TokenSectionTitle" Grid.Row="4" Style="{StaticResource SectionTitle}"
                       Margin="2,8,0,8" Text="🔑 Token 监控"/>

            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="TokenEmpty" Text="在设置中添加 Token 账户"
                               FontSize="11" Foreground="{DynamicResource BrushFg2}" Margin="2,0,0,8"/>
                    <ItemsControl x:Name="TokenList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}" Tag="{Binding Account.Id}"
                                        MouseLeftButtonDown="OnTokenRowClick">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushFg1}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProviderName}" FontSize="10"
                                                           Foreground="{DynamicResource BrushFg2}"
                                                           Margin="6,2,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding ProviderNameVisible, Converter={x:Static app:BoolToVisibilityConverter.Instance}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushNormal}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="warn">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushWarn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="danger">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="error">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushUrgent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource TokenBar}"
                                                     Minimum="0" Maximum="1"
                                                     Value="{Binding BarRatio, Mode=OneWay}"
                                                     Margin="0,6,0,0"
                                                     Visibility="{Binding BarRatio, Converter={x:Static app:BarRatioToVisibilityConverter.Instance}}"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DetailText}" FontSize="10"
                                                       Foreground="{DynamicResource BrushFg2}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ErrorText}" FontSize="10"
                                                       Foreground="{DynamicResource BrushUrgent}"
                                                       MaxWidth="170" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ErrorText}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
