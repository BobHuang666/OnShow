<Window Icon="pack://application:,,,/Assets/onshow.ico" x:Class="OnShow.App.Views.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token 账户" Width="440" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}" WindowStartupLocation="CenterOwner" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="20,18">
        <TextBlock x:Name="HeaderText" Text="添加 Token 账户" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource BrushFg1}" Margin="0,0,0,16"/>

        <Label Content="显示名称（留空用服务商名）"/>
        <TextBox x:Name="NameBox" MinHeight="34" Margin="0,6,0,14"/>

        <Label Content="服务商"/>
        <ComboBox x:Name="ProviderBox" Height="34" Margin="0,6,0,14"
                  DisplayMemberPath="DisplayName" SelectionChanged="OnProviderChanged"/>

        <Label Content="Base URL（留空用默认）"/>
        <TextBox x:Name="BaseUrlBox" MinHeight="34" Margin="0,6,0,5"/>
        <TextBlock x:Name="BaseUrlHint" FontSize="10" Foreground="{DynamicResource BrushFg2}" Margin="2,0,0,14"/>

        <Label Content="控制台网址（可选，点击面板行跳转）"/>
        <TextBox x:Name="ConsoleUrlBox" MinHeight="34" Margin="0,6,0,14"/>

        <StackPanel x:Name="CredPanel"/>

        <StackPanel x:Name="ManualPanel" Visibility="Collapsed">
            <Label Content="已用"/>
            <TextBox x:Name="UsedBox" MinHeight="34" Margin="0,6,0,14"/>
            <Label Content="额度上限"/>
            <TextBox x:Name="LimitBox" MinHeight="34" Margin="0,6,0,14"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TestBtn" Content="测试连接" Margin="0,0,9,0" Click="OnTest"/>
            <Button Content="取消" Margin="0,0,9,0" IsCancel="True"/>
            <Button Content="保存" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
