<Window Icon="pack://application:,,,/Assets/onshow.ico" x:Class="OnShow.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnShow" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border CornerRadius="12" Background="{StaticResource BrushPanel}"
            BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1" Margin="10"
            MouseLeftButtonDown="OnDragAreaMouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="20,18">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBadge" Width="32" Height="32" CornerRadius="9"
                        Background="{StaticResource BrushAccentDim}" VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="ℹ" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="提示" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource BrushFg1}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Text="" FontSize="13"
                       Foreground="{StaticResource BrushFg1}" TextWrapping="Wrap"
                       LineHeight="21" Margin="0,14,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelBtn" Content="取消" Margin="0,0,9,0" IsCancel="True" Click="OnCancel"/>
                <Button x:Name="OkBtn" Content="确定" Style="{StaticResource BtnPrimary}"
                        IsDefault="True" Click="OnOk" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
