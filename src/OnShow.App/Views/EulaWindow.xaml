<Window Icon="pack://application:,,,/Assets/onshow.ico" x:Class="OnShow.App.Views.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 OnShow" Width="700" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border CornerRadius="12" Background="{StaticResource BrushPanel}"
            BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1" Margin="10"
            MouseLeftButtonDown="OnDragAreaMouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="11"
                        Background="{StaticResource BrushAccentDim}" VerticalAlignment="Center">
                    <TextBlock Text="O" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="欢迎使用 OnShow" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushFg1}"/>
                    <TextBlock Text="在开始使用前,请阅读并同意以下协议" FontSize="12"
                               Foreground="{StaticResource BrushFg2}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,14" Background="{StaticResource BrushCard}"
                    CornerRadius="10" Padding="18,12">
                <FlowDocumentScrollViewer x:Name="DocViewer" VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"/>
            </Border>

            <StackPanel Grid.Row="2">
                <CheckBox x:Name="AgreeBox" Checked="OnAgreeChanged" Unchecked="OnAgreeChanged"
                          Content="我已阅读并同意《用户协议》与《隐私与信息安全声明》"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="拒绝并退出" Click="OnDecline" MinWidth="100" Margin="0,0,9,0"/>
                    <Button x:Name="AcceptBtn" Content="同意并继续" Style="{StaticResource BtnPrimary}"
                            IsEnabled="False" Click="OnAccept" MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
