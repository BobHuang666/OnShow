<Window Icon="pack://application:,,,/Assets/onshow.ico" x:Class="OnShow.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OnShow.App"
        Title="OnShow 设置" Width="680" Height="580"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        Background="{StaticResource BrushWindowBg}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="20,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== 导航 ===== -->
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="8,2,0,14">
                <Ellipse Width="9" Height="9" Fill="{StaticResource BrushAccent}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock Text="OnShow" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushFg1}"/>
            </StackPanel>
            <ListBox x:Name="NavList" SelectionChanged="OnNavChanged">
                <ListBoxItem Content="⚙  通用" IsSelected="True" Padding="12,9"/>
                <ListBoxItem Content="⏰  DDL 管理" Padding="12,9"/>
                <ListBoxItem Content="🔑  Token 账户" Padding="12,9"/>
                <ListBoxItem Content="ℹ  关于" Padding="12,9"/>
            </ListBox>
            <TextBlock x:Name="NavVersion" Text="v1.1.0" FontSize="10" Foreground="{StaticResource BrushFg2}"
                       Margin="12,10,0,0"/>
        </StackPanel>

        <!-- ===== 内容 ===== -->
        <Grid Grid.Column="1" Margin="18,0,4,0">

            <!-- 通用 -->
            <StackPanel x:Name="PageGeneral">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="桌面与外观" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushFg1}" Margin="0,0,0,10"/>
                        <Label Content="桌面模式"/>
                        <ComboBox x:Name="ModeBox" Height="34" Margin="0,5,0,14" SelectionChanged="OnModeChanged">
                            <ComboBoxItem Content="桌面前置(图标之上、应用之下)"/>
                            <ComboBoxItem Content="始终置顶"/>
                        </ComboBox>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="面板不透明度"/>
                                <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1"
                                        SmallChange="0.02" LargeChange="0.05"
                                        ValueChanged="OnOpacityChanged" Margin="0,6,4,0"/>
                            </StackPanel>
                            <TextBlock x:Name="OpacityValue" Grid.Column="1" Text="96%"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Bottom" Margin="10,0,2,4"/>
                        </Grid>
                        <CheckBox x:Name="LockBox" Content="锁定位置(禁用拖动)"
                                  Checked="OnFlagChanged" Unchecked="OnFlagChanged"/>
                        <CheckBox x:Name="FlyoutBox" Content="托盘图标悬停显示快览面板" Margin="0,9,0,0"
                                  Checked="OnFlagChanged" Unchecked="OnFlagChanged"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushFg1}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="AutoStartBox" Content="开机自启动(仅托盘,不弹窗)"
                                  Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                        <CheckBox x:Name="LaunchMinBox" Content="启动时只在托盘(不显示 Widget)" Margin="0,9,0,0"
                                  Checked="OnFlagChanged" Unchecked="OnFlagChanged"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Token 轮询" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushFg1}" Margin="0,0,0,10"/>
                        <Label Content="刷新间隔"/>
                        <ComboBox x:Name="PollBox" Height="34" Width="180" HorizontalAlignment="Left"
                                  Margin="0,5,0,0" SelectionChanged="OnPollChanged">
                            <ComboBoxItem Content="5 分钟" Tag="5"/>
                            <ComboBoxItem Content="10 分钟" Tag="10"/>
                            <ComboBoxItem Content="15 分钟" Tag="15"/>
                            <ComboBoxItem Content="30 分钟" Tag="30"/>
                            <ComboBoxItem Content="60 分钟" Tag="60"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- DDL 管理 -->
            <DockPanel x:Name="PageDdl" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="新建" Click="OnDdlAdd" Margin="0,0,8,0"/>
                    <Button Content="编辑" Click="OnDdlEdit" Margin="0,0,8,0"/>
                    <Button Content="完成 / 恢复" Click="OnDdlToggleDone" Margin="0,0,8,0"/>
                    <Button Content="删除" Click="OnDdlDelete"/>
                </StackPanel>
                <ListBox x:Name="DdlManageList" Margin="0,0,0,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    <TextBlock Text="{Binding DueText}" Foreground="{StaticResource BrushFg2}"/>
                                    <TextBlock Text="(已完成)" Foreground="{StaticResource BrushOver}"
                                               Visibility="{Binding Done, Converter={x:Static app:BoolToVisibilityConverter.Instance}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding RemainText}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Token 账户 -->
            <DockPanel x:Name="PageToken" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="新建" Click="OnAccountAdd" Margin="0,0,8,0"/>
                    <Button Content="编辑" Click="OnAccountEdit" Margin="0,0,8,0"/>
                    <Button Content="删除" Click="OnAccountDelete" Margin="0,0,8,0"/>
                    <Button Content="立即刷新" Click="OnTokenRefresh"/>
                </StackPanel>
                <ListBox x:Name="AccountManageList" Margin="0,0,0,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" TextAlignment="Right"
                                           Margin="12,0,0,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProviderName}" FontSize="10"
                                               Foreground="{StaticResource BrushFg2}"
                                               Visibility="{Binding ProviderNameVisible, Converter={x:Static app:BoolToVisibilityConverter.Instance}}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ErrorText}" FontSize="11"
                                           Foreground="{StaticResource BrushUrgent}" Margin="12,1,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320"
                                           HorizontalAlignment="Right"
                                           ToolTip="{Binding ErrorText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 关于 -->
            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="AboutTitle" Text="OnShow v1.1.0" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,8"/>
                        <TextBlock Foreground="{StaticResource BrushFg2}" TextWrapping="Wrap" LineHeight="20"
                                   Text="桌面常驻信息小部件:DDL 倒计时 + Token 集成监控。&#x0a;数据与配置保存在 %APPDATA%\OnShow,密钥经 DPAPI 加密;无任何遥测。"/>
                        <CheckBox x:Name="AutoUpdateBox" Content="自动检查更新(每 24 小时静默检查一次)"
                                  Margin="0,12,0,0" Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="检查更新" Style="{StaticResource BtnPrimary}" Click="OnCheckUpdate" Margin="0,0,9,0"/>
                            <Button Content="反馈问题" Click="OnFeedback" Margin="0,0,9,0"/>
                            <Button Content="更新日志 / 用户协议" Click="OnOpenAbout"/>
                        </StackPanel>
                        <Label Content="下载加速镜像(仅加速安装包下载;SHA256 校验仍走 GitHub 官方;留空直连)" Margin="0,14,0,0"/>
                        <TextBox x:Name="MirrorBox" Height="32" VerticalContentAlignment="Center"
                                 TextChanged="OnMirrorChanged"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource BrushOver}" Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Text="默认使用公共加速镜像;若失效可更换前缀或留空直连。镜像只加速下载,内容完整性由 SHA256 校验保证。"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="接口适配提示" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushWarn}" Margin="0,0,0,8"/>
                        <TextBlock Foreground="{StaticResource BrushFg2}" TextWrapping="Wrap" LineHeight="20"
                                   Text="智谱与讯飞为非公开文档接口,若「测试连接」失败,请用托盘菜单「反馈」把响应情况发给开发者以适配(注意脱敏)。"/>
                    </StackPanel>
                </Border>
                <Button Content="打开数据目录" HorizontalAlignment="Left" Click="OnOpenDataFolder"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
