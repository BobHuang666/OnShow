<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OnShow.App</RootNamespace>
    <AssemblyName>OnShow</AssemblyName>
    <Version>1.1.1</Version>
    <ApplicationIcon>Assets\onshow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\onshow.ico" />
  </ItemGroup>

  <!-- 协议文档与更新日志:随程序内嵌,「关于」窗口离线可读 -->
  <ItemGroup>
    <Resource Include="Assets\Docs\UserAgreement.md" />
    <Resource Include="Assets\Docs\PrivacyStatement.md" />
    <Resource Include="..\..\CHANGELOG.md" Link="Docs\CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnShow.Core\OnShow.Core.csproj" />
    <ProjectReference Include="..\OnShow.Cards.Ddl\OnShow.Cards.Ddl.csproj" />
    <ProjectReference Include="..\OnShow.Cards.Token\OnShow.Cards.Token.csproj" />
  </ItemGroup>

</Project>
